# -----------------------------------------------------------------------------
# Rebuzzle — environment template
# Copy to .env.local for local development. Never commit real secrets.
# Validation: apps/web/src/lib/env.ts
# -----------------------------------------------------------------------------

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Database (prefer REBUZZLE_MONGODB_URI; MONGODB_URI / DATABASE_URL also work)
REBUZZLE_MONGODB_URI=
# MONGODB_URI=
# DATABASE_URL=
MONGODB_DB=rebuzzle

# Auth / security
AUTH_SECRET=
CRON_SECRET=
# VERCEL_CRON_SECRET=
# VERCEL_OIDC_TOKEN=

# AI provider: google | groq | xai | openai | gateway
AI_PROVIDER=gateway
AI_GATEWAY_API_KEY=
# GOOGLE_AI_API_KEY=
# GROQ_API_KEY=
# XAI_API_KEY=
# OPENAI_API_KEY=

# Puzzle generation controls (defaults are production-safe)
# EVE_PUZZLE_MODEL=
# DEFAULT_PUZZLE_TYPE=
EVE_APEX_CANDIDATES=2
REBUZZLE_GENERATOR_MODEL_CHAIN_LIMIT=1
# AI_PUZZLE_GENERATION=
# AI_ADVANCED_GENERATION=
# AI_SMART_VALIDATION=
# AI_DYNAMIC_HINTS=

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# FROM_EMAIL=
# Inbox for /api/feedback (defaults to RESEND_FROM_EMAIL / hello@byronwade.com)
# FEEDBACK_TO_EMAIL=

# Web push (VAPID)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Optional: Sentry
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# -----------------------------------------------------------------------------
# AI-authored blog pull requests
# Preferred: a GitHub App installed only on this repository with
# Contents: Read and write and Pull requests: Read and write.
# -----------------------------------------------------------------------------
GITHUB_BLOG_APP_ID=
GITHUB_BLOG_APP_INSTALLATION_ID=
GITHUB_BLOG_APP_PRIVATE_KEY=

# Alternative: a fine-grained repository token with the same permissions.
GITHUB_BLOG_TOKEN=

GITHUB_BLOG_REPOSITORY=byronwade/rebuzzle.byronwade.com
GITHUB_BLOG_BASE_BRANCH=main
GITHUB_BLOG_PR_DRAFT=true
