{
  "name": "rebuzzle-monorepo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "format": "pnpm --filter @rebuzzle/web format",
    "check": "pnpm lint && pnpm typecheck",
    "clean": "turbo clean && rm -rf node_modules",
    "dev:web": "pnpm --filter @rebuzzle/web dev",
    "dev:desktop": "pnpm --filter @rebuzzle/desktop dev",
    "dev:mobile": "pnpm --filter @rebuzzle/mobile dev",
    "build:web": "pnpm --filter @rebuzzle/web build",
    "build:desktop": "pnpm --filter @rebuzzle/desktop build",
    "build:mobile": "pnpm --filter @rebuzzle/mobile build",
    "lint:web": "pnpm --filter @rebuzzle/web lint",
    "knip:web": "pnpm --filter @rebuzzle/web knip",
    "doctor:web": "pnpm --filter @rebuzzle/web doctor:all"
  },
  "devDependencies": {
    "turbo": "^2.10.8",
    "@biomejs/biome": "^2.5.6",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.18",
      "@types/react-dom": "19.2.4"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "react": "*",
        "@types/react": "*"
      },
      "ignoreMissing": [
        "react",
        "react-dom",
        "@types/react"
      ]
    }
  }
}
