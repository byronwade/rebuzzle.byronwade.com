{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "src/app/**/{page,layout,loading,error,not-found,global-error,route,default,template}.{js,jsx,ts,tsx}",
    "next.config.mjs",
    "postcss.config.mjs",
    "tailwind.config.ts",
    "scripts/**/*.{ts,js}",
    "agent/**/*.{ts,js}",
    "emails/**/*.{ts,tsx}",
    "jest.config.js",
    "playwright.config.ts",
    "e2e/**/*.{ts,tsx}",
    "src/**/__tests__/**/*.{ts,tsx}",
    "src/**/*.test.{ts,tsx}"
  ],
  "project": [
    "src/**/*.{ts,tsx,js,jsx}",
    "scripts/**/*.{ts,js}",
    "agent/**/*.{ts,js}",
    "emails/**/*.{ts,tsx}",
    "e2e/**/*.{ts,tsx}"
  ],
  "ignore": [
    "**/*.d.ts",
    "**/*.config.{js,ts,mjs}",
    "**/node_modules/**",
    ".next/**",
    "dist/**",
    "build/**",
    "tsconfig.tsbuildinfo",
    "scripts/setup-database.ts",
    "scripts/setup-neon.ts",
    "scripts/setup-neon-auth.ts",
    "scripts/test-database.ts",
    "scripts/generatePuzzles.ts",
    "scripts/generate-migrations.ts",
    "scripts/migrate-embeddings.ts"
  ],
  "ignoreDependencies": [
    "autoprefixer",
    "postcss",
    "tailwindcss",
    "@types/node",
    "@types/react",
    "@types/react-dom",
    "@types/canvas-confetti",
    "@types/web-push",
    "@types/bcryptjs",
    "@types/uuid",
    "@rebuzzle/config",
    "@rebuzzle/game-logic"
  ],
  "next": {
    "entry": [
      "src/app/**/{page,layout,loading,error,not-found,global-error,route,default,template}.{js,jsx,ts,tsx}"
    ]
  }
}
